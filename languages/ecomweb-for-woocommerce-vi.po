#: includes/class-admin-page.php:139
#: includes/views/page-connected.php:137
msgid "%1$d created, %2$d updated, %3$d skipped (already copied), %4$d failed."
msgstr "%1$d đã tạo, %2$d đã cập nhật, %3$d đã bỏ qua (đã sao chép), %4$d thất bại."

#: includes/class-admin-page.php:140
msgid "Couldn't check the copy's progress. Trying again; reload the page if this keeps happening."
msgstr "Không kiểm tra được tiến độ sao chép. Đang thử lại; hãy tải lại trang nếu lỗi này tiếp tục xảy ra."

#. translators: %d: number of products ticked in the list.
#: includes/class-admin-page.php:142
