#: includes/views/page-pick-store.php:19
#: includes/views/page-pick-store.php:24
#: includes/views/page-pick-store.php:62
msgid "Refresh"
msgstr "Làm mới"

#. translators: 1: products selected, 2: new, 3: already in ecomweb, 4: deleted in ecomweb.
#: includes/views/page-confirm.php:38
msgid "%1$d product selected: %2$d new, %3$d already in EcomWeb, %4$d deleted in EcomWeb."
msgid_plural "%1$d products selected: %2$d new, %3$d already in EcomWeb, %4$d deleted in EcomWeb."
msgstr[0] "Đã chọn %1$d sản phẩm: %2$d mới, %3$d đã có trên EcomWeb, %4$d đã bị xóa trên EcomWeb."

#: includes/views/page-confirm.php:51
msgid "Products deleted in EcomWeb are left out."
msgstr "Sản phẩm đã bị xóa trên EcomWeb sẽ không được sao chép."

#. translators: %d: number of products.
#: includes/views/page-confirm.php:59
msgid "%d products can't be copied (grouped or external)."
msgstr "%d sản phẩm không thể sao chép (sản phẩm nhóm hoặc bên ngoài)."

#. translators: 1: ecomweb store currency, 2: WooCommerce currency.
#: includes/views/page-confirm.php:70
msgid "Your EcomWeb store uses %1$s and WooCommerce uses %2$s. EcomWeb doesn't convert prices: make the currencies match, then try again."
msgstr "Cửa hàng EcomWeb của bạn dùng %1$s còn WooCommerce dùng %2$s. EcomWeb không quy đổi giá: hãy làm cho hai đơn vị tiền tệ khớp nhau rồi thử lại."

#. translators: 1: plan product limit, 2: products in the store now, 3: products that fit, 4: products to create.
#: includes/views/page-confirm.php:85
msgid "Your plan allows %1$d products and the store has %2$d, so %3$d of these %4$d fit."
msgstr "Gói của bạn cho phép %1$d sản phẩm và cửa hàng hiện có %2$d, nên chỉ %3$d trong %4$d sản phẩm này vừa giới hạn."

#. translators: 1: image storage used, in MB. 2: image storage limit, in MB.
#: includes/views/page-confirm.php:105
msgid "Your store has used %1$s MB of %2$s MB of image storage. Images beyond that will fail to copy."
msgstr "Cửa hàng của bạn đã dùng %1$s MB trong %2$s MB dung lượng lưu hình ảnh. Các hình ảnh vượt quá mức này sẽ không sao chép được."

#: includes/views/page-confirm.php:117
#: includes/views/page-confirm.php:171
msgid "Upgrade your plan"
msgstr "Nâng cấp gói"

#: includes/views/page-confirm.php:129
msgid "Overwrite products already copied"
msgstr "Ghi đè sản phẩm đã sao chép"

#. translators: %d: number of products.
#: includes/views/page-confirm.php:139
msgid "Yes, overwrite %d products in EcomWeb. Their EcomWeb status stays as it is."
msgstr "Đồng ý, ghi đè %d sản phẩm trên EcomWeb. Trạng thái của chúng trên EcomWeb được giữ nguyên."

#. translators: %d: number of products already copied.
#: includes/views/page-confirm.php:151
msgid "Your plan has no room for new products. You can still overwrite the %d products already copied."
msgstr "Gói của bạn không còn chỗ cho sản phẩm mới. Bạn vẫn có thể ghi đè %d sản phẩm đã sao chép."

#: includes/views/page-confirm.php:159
#: includes/views/page-confirm.php:168
msgid "Start copying"
msgstr "Bắt đầu sao chép"

#. translators: %d: number of products.
