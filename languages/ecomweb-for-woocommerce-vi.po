msgstr "Sao chép sang EcomWeb"

#: includes/class-upload-image-resolver.php:102
msgid "An image could not be copied because it is missing or is not an image."
msgstr "Không sao chép được một hình ảnh vì hình ảnh bị thiếu hoặc không phải là hình ảnh."

#: includes/class-upload-image-resolver.php:106
msgid "An image could not be copied because its file could not be read."
msgstr "Không sao chép được một hình ảnh vì không đọc được tệp."

#: includes/class-upload-image-resolver.php:109
msgid "An image could not be copied because it is larger than 10 MB."
msgstr "Không sao chép được một hình ảnh vì dung lượng lớn hơn 10 MB."

#: includes/class-upload-image-resolver.php:112
#: includes/class-upload-image-resolver.php:137
msgid "An image could not be uploaded."
msgstr "Không tải lên được một hình ảnh."

#: includes/views/page-confirm.php:16
msgid "Review the copy"
msgstr "Xem lại trước khi sao chép"

#: includes/views/page-confirm.php:19
#: includes/views/page-confirm.php:24
#: includes/views/page-confirm.php:119
#: includes/views/page-confirm.php:173
#: includes/views/page-confirm.php:179
msgid "Cancel"
msgstr "Hủy"

#: includes/views/page-confirm.php:23
