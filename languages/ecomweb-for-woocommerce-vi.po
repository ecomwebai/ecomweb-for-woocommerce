msgstr "Hãy chờ lần sao chép hiện tại hoàn tất."

#: includes/class-admin-page.php:327
msgid "Sign in with EcomWeb and choose a store first."
msgstr "Hãy đăng nhập bằng EcomWeb và chọn cửa hàng trước."

#: includes/class-admin-page.php:330
msgid "Select at least one product to copy."
msgstr "Hãy chọn ít nhất một sản phẩm để sao chép."

#: includes/class-admin-page.php:333
msgid "Choose a store first."
msgstr "Hãy chọn cửa hàng trước."

#: includes/class-admin-page.php:336
#: includes/class-connection.php:114
#: includes/class-connection.php:199
#: includes/class-preflight.php:89
