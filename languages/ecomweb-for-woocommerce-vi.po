#: includes/views/page-signed-out.php:17
msgid "Sign in with your ecomweb account to copy your WooCommerce products into an ecomweb store."
msgstr "Đăng nhập bằng tài khoản ecomweb để sao chép sản phẩm WooCommerce của bạn sang cửa hàng ecomweb."

#: includes/views/page-signed-out.php:18
msgid "Sign in with ecomweb"
msgstr "Đăng nhập bằng ecomweb"

#: includes/views/page-signed-out.php:19
#: includes/views/page-signing-in.php:35
msgid "ecomweb will show your web host's location, not yours."
msgstr "ecomweb sẽ hiển thị vị trí của nhà cung cấp hosting, không phải vị trí của bạn."

#. translators: %s: the sign-in code, in bold.
#: includes/views/page-signing-in.php:22
msgid "Your code: %s"
msgstr "Mã của bạn: %s"

#: includes/views/page-signing-in.php:32
msgid "Check that ecomweb shows the same code, then approve."
msgstr "Hãy kiểm tra ecomweb hiển thị cùng một mã, rồi xác nhận."

#: includes/views/page-signing-in.php:33
msgid "Open ecomweb"
msgstr "Mở ecomweb"
