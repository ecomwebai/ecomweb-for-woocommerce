msgstr "Không kết nối được với ecomweb. Hãy thử lại sau giây lát."

#: includes/class-api-client.php:154
#: includes/class-auth.php:525
msgid "You were signed out of ecomweb. Sign in again."
msgstr "Bạn đã bị đăng xuất khỏi ecomweb. Hãy đăng nhập lại."

