msgid "Sign in to ecomweb first."
msgstr "Hãy đăng nhập vào ecomweb trước."

#: includes/class-auth.php:543
msgid "ecomweb is busy. Try again in a moment."
msgstr "ecomweb đang bận. Hãy thử lại sau giây lát."

#: includes/class-auth.php:561
msgid "ecomweb sent an unexpected answer. Try again."
msgstr "ecomweb trả về phản hồi không mong đợi. Hãy thử lại."

#: includes/class-connection.php:80
msgid "Only the store owner or an admin can copy products"
msgstr "Chỉ chủ cửa hàng hoặc quản trị viên mới có thể sao chép sản phẩm"

#: includes/class-connection.php:125
#: includes/class-connection.php:203
#: includes/class-preflight.php:99
