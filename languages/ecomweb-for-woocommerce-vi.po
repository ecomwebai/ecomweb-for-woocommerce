#: includes/class-copy-runner.php:109
#: includes/class-preflight.php:60
msgid "Choose an ecomweb store first."
msgstr "Hãy chọn cửa hàng ecomweb trước."

#: includes/class-copy-runner.php:214
#: includes/class-messages.php:88
msgid "The copy stopped unexpectedly on this site. Copy again; products already copied are skipped."
msgstr "Việc sao chép đã dừng đột ngột trên trang này. Hãy sao chép lại; sản phẩm đã sao chép sẽ được bỏ qua."

#: includes/class-copy-runner.php:273
msgid "This site is no longer connected to that ecomweb store. Choose the store again."
msgstr "Trang này không còn được kết nối với cửa hàng ecomweb đó. Hãy chọn lại cửa hàng."

#: includes/class-copy-runner.php:391
msgid "ecomweb took too long to copy a batch."
msgstr "ecomweb mất quá nhiều thời gian để sao chép một lô sản phẩm."

#: includes/class-copy-runner.php:441
msgid "ecomweb did not report a result for this product."
msgstr "ecomweb không báo kết quả cho sản phẩm này."

#: includes/class-messages.php:30
msgid "On sale in WooCommerce; the regular price was not copied"
msgstr "Đang giảm giá trên WooCommerce; giá gốc chưa được sao chép"

#. translators: %s: the regular price.
#: includes/class-messages.php:33
msgid "On sale in WooCommerce; regular price %s was not copied"
msgstr "Đang giảm giá trên WooCommerce; giá gốc %s chưa được sao chép"

#: includes/class-messages.php:35
msgid "An image could not be copied."
msgstr "Không sao chép được một hình ảnh."

#: includes/class-messages.php:37
msgid "Only the first 20 images were copied."
msgstr "Chỉ 20 hình ảnh đầu tiên được sao chép."

#: includes/class-messages.php:39
msgid "Choose a product category for it in ecomweb."
msgstr "Hãy chọn danh mục sản phẩm cho sản phẩm này trên ecomweb."

#: includes/class-messages.php:41
msgid "Its URL slug was taken in ecomweb, so a suffix was added."
msgstr "Đường dẫn (slug) của sản phẩm đã có trên ecomweb nên một hậu tố đã được thêm vào."

#: includes/class-messages.php:43
msgid "Some description markup (scripts, styles, forms or embeds) was removed."
msgstr "Một số mã trong phần mô tả (script, kiểu dáng, biểu mẫu hoặc nội dung nhúng) đã bị loại bỏ."

#: includes/class-messages.php:45
msgid "A variation removed in WooCommerce was set to inactive in ecomweb."
msgstr "Một biến thể đã bị xóa trên WooCommerce được đặt ở trạng thái không hoạt động trên ecomweb."

#: includes/class-messages.php:61
msgid "This product can't be copied: grouped and external products, and variable products without variations, aren't supported."
msgstr "Không thể sao chép sản phẩm này: sản phẩm nhóm, sản phẩm bên ngoài và sản phẩm có biến thể nhưng chưa có biến thể nào đều không được hỗ trợ."

#: includes/class-messages.php:63
msgid "ecomweb supports up to 3 variation attributes; this product has more."
msgstr "ecomweb hỗ trợ tối đa 3 thuộc tính biến thể; sản phẩm này có nhiều hơn."

#: includes/class-messages.php:65
msgid "Too many variations for ecomweb once “Any” values are expanded."
msgstr "Quá nhiều biến thể đối với ecomweb sau khi các giá trị “Bất kỳ” được mở rộng."

#: includes/class-messages.php:67
msgid "A variation uses “Any” for an attribute that has no values."
msgstr "Một biến thể dùng “Bất kỳ” cho thuộc tính không có giá trị nào."

#: includes/class-messages.php:69
msgid "ecomweb couldn't copy this product. Try again later."
msgstr "ecomweb không sao chép được sản phẩm này. Hãy thử lại sau."

#. translators: %s: the reason ecomweb gave.
#: includes/class-messages.php:72
msgid "ecomweb rejected this batch: %s"
msgstr "ecomweb đã từ chối lô sản phẩm này: %s"

#: includes/class-messages.php:74
msgid "Your ecomweb plan's product limit was reached. Upgrade, then copy again."
msgstr "Đã đạt giới hạn sản phẩm của gói ecomweb. Hãy nâng cấp rồi sao chép lại."

#: includes/class-messages.php:76
msgid "The store currency no longer matches WooCommerce."
msgstr "Đơn vị tiền tệ của cửa hàng không còn khớp với WooCommerce."

#: includes/class-messages.php:78
msgid "This site's connection was removed in ecomweb. Choose the store again."
msgstr "Kết nối của trang này đã bị gỡ trên ecomweb. Hãy chọn lại cửa hàng."

#: includes/class-messages.php:82
msgid "You no longer have access to this store in ecomweb."
msgstr "Bạn không còn quyền truy cập cửa hàng này trên ecomweb."

#: includes/class-messages.php:84
msgid "ecomweb can't be reached right now. Copy again later; products already copied are skipped."
msgstr "Hiện chưa kết nối được với ecomweb. Hãy sao chép lại sau; sản phẩm đã sao chép sẽ được bỏ qua."

#: includes/class-messages.php:86
msgid "ecomweb took too long to answer. Copy again later; products already copied are skipped."
msgstr "ecomweb phản hồi quá chậm. Hãy sao chép lại sau; sản phẩm đã sao chép sẽ được bỏ qua."

#: includes/class-messages.php:90
msgid "ecomweb is still busy with another copy of this site. Copy again later; products already copied are skipped."
msgstr "ecomweb vẫn đang bận với một lần sao chép khác của trang này. Hãy sao chép lại sau; sản phẩm đã sao chép sẽ được bỏ qua."

#: includes/class-messages.php:92
msgid "ecomweb is limiting requests right now. Copy again later; products already copied are skipped."
msgstr "ecomweb đang giới hạn số yêu cầu. Hãy sao chép lại sau; sản phẩm đã sao chép sẽ được bỏ qua."

#: includes/class-plugin.php:197
msgid "ecomweb for WooCommerce needs WooCommerce 8.0 or later."
msgstr "ecomweb cho WooCommerce cần WooCommerce 8.0 trở lên."

